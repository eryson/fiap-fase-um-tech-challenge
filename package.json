{
  "name": "fiap-fase-1-tech-challenge",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node --transpile-only src/main/server.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main/server.ts",
    "build": "rimraf dist && tsc -p tsconfig-build.json",
    "postbuild": "copyfiles -u 1 public/**/* dist/static",
    "test": "yarn run docker:setup && jest --passWithNoTests --runInBand --clearMocks --no-compilation-cache --logHeapUsage --detectOpenHandles --no-cache",
    "test:unit": "dotenv -e tests/docker/.env.test -- npm test -- --watch -c jest-unit-config.js && yarn run docker:teardown",
    "test:integration": "dotenv -e tests/docker/.env.test -- npm test -- --watch -c jest-integration-config.js && yarn run docker:teardown",
    "test:staged": "dotenv -e tests/docker/.env.test -- npm test -- --onlyChanged && yarn run docker:teardown",
    "test:ci": "dotenv -e tests/docker/.env.test -- npm test -- && yarn run docker:teardown",
    "test:coverage": "dotenv -e tests/docker/.env.test -- npm test -- --coverage && yarn run docker:teardown",
    "test:file": "dotenv -e tests/docker/.env.test -- yarn docker:setup && jest -c jest-unit-config.js --runInBand",
    "docker:setup": "docker compose -f tests/docker/docker-compose.test.yml up -d && npx wait-on tcp:6380",
    "docker:teardown": "docker compose -f tests/docker/docker-compose.test.yml down -v",
    "prepare": "husky install",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
    "generate-docs": "ts-node src/main/docs/swagger/swagger.ts",
    "release": "standard-version",
    "prisma:generate": "prisma generate --schema=src/infra/db/prisma-mysql/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/infra/db/prisma-mysql/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
