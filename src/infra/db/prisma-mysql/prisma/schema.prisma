generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  document  String   @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]

  @@map("clients")
}

model Vehicle {
  id       Int    @id @default(autoincrement())
  clientId Int
  plate    String @unique
  brand    String
  model    String
  year     Int

  client        Client         @relation(fields: [clientId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([clientId])
  @@map("vehicles")
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Decimal @db.Decimal(10, 2)

  serviceOrders ServiceOrderService[]

  @@map("services")
}

model Part {
  id            Int     @id @default(autoincrement())
  name          String
  sku           String  @unique
  price         Decimal @db.Decimal(10, 2)
  stockQuantity Int     @default(0)

  serviceOrders ServiceOrderPart[]

  @@map("parts")
}

enum ServiceOrderStatus {
  received
  diagnosing
  awaiting_approval
  in_progress
  finished
  delivered
}

model ServiceOrder {
  id          Int                @id @default(autoincrement())
  protocol    String             @unique
  clientId    Int
  vehicleId   Int
  status      ServiceOrderStatus @default(received)
  budgetTotal Decimal            @db.Decimal(10, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client  Client  @relation(fields: [clientId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  services ServiceOrderService[]
  parts    ServiceOrderPart[]

  @@index([clientId])
  @@index([vehicleId])
  @@map("service_orders")
}

model ServiceOrderService {
  serviceOrderId Int
  serviceId      Int

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  @@id([serviceOrderId, serviceId])
  @@map("service_order_services")
}

model ServiceOrderPart {
  serviceOrderId Int
  partId         Int
  quantity       Int @default(1)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  part         Part         @relation(fields: [partId], references: [id])

  @@id([serviceOrderId, partId])
  @@map("service_order_parts")
}
